<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/mahali">
    <file alias="themes/light.qss">themes/light.qss</file>
    <file alias="themes/dark.qss">themes/dark.qss</file>
    <file alias="icons/app-32.png">icons/app-32.png</file>
    <file alias="icons/app-48.png">icons/app-48.png</file>
    <file alias="icons/app-64.png">icons/app-64.png</file>
    <file alias="icons/app-128.png">icons/app-128.png</file>
    <file alias="icons/app-256.png">icons/app-256.png</file>
    <file alias="icons/app-512.png">icons/app-512.png</file>
    <file alias="icons/app.ico">icons/mahali.ico</file>
  </qresource>
</RCC>