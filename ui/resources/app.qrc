<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/mahali">
    <file alias="themes/light.qss">themes/light.qss</file>
    <file alias="themes/dark.qss">themes/dark.qss</file>
    <!-- The application icon, shared with the Windows resource script. The
         previous entry pointed at icons/mahali.ico under this same alias, so it
         was replaced rather than added: rcc rejects a duplicate alias. The PNG
         size set that used to sit next to it is gone: the .ico carries all six
         sizes on its own, so the window icon loads from this one entry. -->
    <file alias="icons/app.ico">../../apps/desktop/mahali-orange.ico</file>
  </qresource>
</RCC>